# GoForge configuration template.
# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.
#
# Precedence (low -> high): struct defaults < .env < process environment < CLI flags.
# So a value here is a default that the shell environment or a flag can override.

# Provider: openai (default) or anthropic.
GOFORGE_PROVIDER=openai

# Model name. Leave blank to use the provider's default.
GOFORGE_MODEL=

# Custom API base URL for OpenAI-compatible endpoints (blank = official API).
GOFORGE_BASE_URL=

# Interactive mode: chat | tools | agent (default agent).
GOFORGE_MODE=agent

# Max ReAct steps (agent mode only).
GOFORGE_MAX_STEPS=10

# Per-tool execution timeout (agent mode only), as a Go duration (e.g. 30s, 1m).
GOFORGE_TOOL_TIMEOUT=30s

# System prompt.
GOFORGE_SYSTEM=You are a helpful assistant. You can use tools when needed.

# Sandbox root directories for file tools (read/write/list), comma-separated.
# Files can be accessed within ANY listed directory. Blank = current dir only.
# Example: GOFORGE_WORKDIR=/home/user/project,/home/user/docs
GOFORGE_WORKDIR=

# Shell command allowlist (comma-separated). Blank disables the exec_command
# tool entirely. Only the listed programs may be run, with no shell. e.g. echo,ls,go
GOFORGE_ALLOW_COMMANDS=

# Path to a standard mcpServers JSON config (Claude Desktop / Cursor / .mcp.json
# format). Defaults to .mcp.json in the working directory; a missing file simply
# means no MCP servers. Each server's tools are namespaced by its key (e.g. the
# "fs" server's read_file → fs_read_file). Example .mcp.json:
#   {
#     "mcpServers": {
#       "fs":     {"command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","/tmp"]},
#       "bearer": {"url":"https://example.com/mcp","type":"sse","headers":{"Authorization":"Bearer ..."}},
#       "oauthed":{"url":"https://example.com/mcp","type":"streamable",
#                  "oauth":{"clientId":"id","clientSecret":"secret","tokenUrl":"https://example.com/token","scopes":["mcp"]}}
#     }
#   }
GOFORGE_MCP_CONFIG=.mcp.json

# How MCP tools reach the agent: "direct" (each tool registered individually) or
# "broker" (3 meta-tools — mcp_list_tools/mcp_describe_tool/mcp_call_tool — for
# progressive disclosure; better when servers expose many tools).
GOFORGE_MCP_EXPOSE=direct

# API keys (provider-specific). Keep these out of version control.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
